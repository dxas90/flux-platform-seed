uses app-level targetRevision override when provided:
  1: |
    apiVersion: helm.toolkit.fluxcd.io/v2
    kind: HelmRelease
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/part-of: my-app
      name: my-app
      namespace: flux-system
    spec:
      chart:
        spec:
          chart: k8s/chart
          reconcileStrategy: Revision
          sourceRef:
            kind: GitRepository
            name: my-app
            namespace: flux-system
      install:
        remediation:
          retries: 3
      interval: 10m
      releaseName: my-app
      serviceAccountName: app-my-app
      storageNamespace: my-app
      targetNamespace: my-app
      timeout: 5m
      upgrade:
        remediation:
          retries: 3
      values:
        image:
          repository: registry.gitlab.com/org/my-app
