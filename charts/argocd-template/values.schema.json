{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "argocd-template values",
  "type": "object",
  "required": ["tokens", "defaults", "apps"],
  "properties": {
    "tokens": {
      "type": "object",
      "required": ["github", "gitlab"],
      "properties": {
        "github": { "$ref": "#/definitions/tokenRef" },
        "gitlab": { "$ref": "#/definitions/tokenRef" }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "targetRevision": {
          "type": "string",
          "default": "main"
        },
        "syncOptions": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["CreateNamespace=true", "ServerSideApply=true", "FailOnSharedResource=true"]
        },
        "preview": {
          "type": "object",
          "properties": {
            "requeueAfterSeconds": {
              "type": "integer",
              "minimum": 60,
              "default": 600
            },
            "labels": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["preview"]
            }
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/definitions/app" }
    }
  },
  "definitions": {
    "tokenRef": {
      "type": "object",
      "required": ["secretName", "key"],
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Kubernetes secret name in the argocd namespace"
        },
        "key": {
          "type": "string",
          "description": "Secret data key"
        }
      }
    },
    "app": {
      "type": "object",
      "required": ["name", "repo", "chart", "registry"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "App name — lowercase, hyphens OK, must match Kubernetes name rules"
        },
        "repo": {
          "type": "string",
          "format": "uri",
          "description": "Full HTTPS clone URL including .git suffix"
        },
        "chart": {
          "type": "string",
          "description": "Path to the Helm chart directory inside the repo (e.g. k8s/chart)"
        },
        "registry": {
          "type": "string",
          "description": "Container image repository without tag (e.g. ghcr.io/org/app)"
        },
        "targetRevision": {
          "type": "string",
          "description": "Git ref for the stable deployment; overrides defaults.targetRevision"
        },
        "extraHelmParameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" }
            }
          },
          "description": "Additional helm parameters passed to the stable Application"
        },
        "preview": {
          "type": "object",
          "description": "Preview environment config. Omit to disable previews for this app.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Set false to temporarily disable previews without removing the block"
            },
            "namespace": {
              "type": "string",
              "description": "Override the preview namespace (default: <name>-preview)"
            },
            "github": {
              "type": "object",
              "description": "GitHub PR preview. Owner/repo are extracted from the repo URL automatically.",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "gitlab": {
              "type": "object",
              "description": "GitLab MR preview. Requires project ID.",
              "required": ["projectId"],
              "additionalProperties": false,
              "properties": {
                "projectId": {
                  "type": ["string", "integer"],
                  "description": "GitLab project ID or URL-encoded project path"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "GitLab instance URL for self-hosted (optional, defaults to gitlab.com)"
                },
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
