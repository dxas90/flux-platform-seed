matches snapshot:
  1: |
    apiVersion: argoproj.io/v1alpha1
    kind: AppProject
    metadata:
      name: example-api
      namespace: argocd
    spec:
      clusterResourceWhitelist:
        - group: ""
          kind: Namespace
      description: example-api — https://github.com/example-org/example-api.git
      destinations:
        - namespace: example-api
          server: https://kubernetes.default.svc
        - namespace: example-api-preview
          server: https://kubernetes.default.svc
      namespaceResourceWhitelist:
        - group: ""
          kind: ConfigMap
        - group: ""
          kind: Secret
        - group: ""
          kind: Service
        - group: ""
          kind: ServiceAccount
        - group: ""
          kind: PersistentVolumeClaim
        - group: apps
          kind: Deployment
        - group: autoscaling
          kind: HorizontalPodAutoscaler
        - group: policy
          kind: PodDisruptionBudget
        - group: networking.k8s.io
          kind: Ingress
        - group: networking.k8s.io
          kind: NetworkPolicy
        - group: gateway.networking.k8s.io
          kind: HTTPRoute
      sourceRepos:
        - https://github.com/example-org/example-api.git
