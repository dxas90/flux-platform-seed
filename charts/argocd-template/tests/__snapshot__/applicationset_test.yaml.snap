matches snapshot for GitHub preview:
  1: |
    apiVersion: argoproj.io/v1alpha1
    kind: ApplicationSet
    metadata:
      name: example-api-preview
      namespace: argocd
    spec:
      generators:
        - pullRequest:
            github:
              labels:
                - preview
              owner: example-org
              repo: example-api
              tokenRef:
                key: token
                secretName: github-token
            requeueAfterSeconds: 600
      goTemplate: true
      goTemplateOptions:
        - missingkey=error
      template:
        metadata:
          name: example-api-preview-{{.number}}-{{.branch_slug}}
        spec:
          destination:
            namespace: example-api-preview
            server: https://kubernetes.default.svc
          project: example-api
          source:
            helm:
              parameters:
                - name: image.repository
                  value: ghcr.io/example-org/example-api
                - name: image.tag
                  value: '{{.head_sha}}'
              releaseName: example-api-preview-{{.number}}
            path: k8s/chart
            repoURL: https://github.com/example-org/example-api.git
            targetRevision: '{{.head_sha}}'
          syncPolicy:
            automated:
              prune: true
              selfHeal: true
            syncOptions:
              - CreateNamespace=true
              - ServerSideApply=true
              - FailOnSharedResource=true
matches snapshot for GitLab preview:
  1: |
    apiVersion: argoproj.io/v1alpha1
    kind: ApplicationSet
    metadata:
      name: example-service-preview
      namespace: argocd
    spec:
      generators:
        - pullRequest:
            gitlab:
              labels:
                - preview
              project: "30270366"
              tokenRef:
                key: token
                secretName: gitlab-token
            requeueAfterSeconds: 600
      goTemplate: true
      goTemplateOptions:
        - missingkey=error
      template:
        metadata:
          name: example-service-preview-{{.number}}-{{.branch_slug}}
        spec:
          destination:
            namespace: example-service-preview
            server: https://kubernetes.default.svc
          project: example-service
          source:
            helm:
              parameters:
                - name: image.repository
                  value: registry.gitlab.com/example-org/example-service
                - name: image.tag
                  value: '{{.head_sha}}'
              releaseName: example-service-preview-{{.number}}
            path: k8s/example-service
            repoURL: https://gitlab.com/example-org/example-service.git
            targetRevision: '{{.head_sha}}'
          syncPolicy:
            automated:
              prune: true
              selfHeal: true
            syncOptions:
              - CreateNamespace=true
              - ServerSideApply=true
              - FailOnSharedResource=true
matches snapshot for self-hosted GitLab preview:
  1: |
    apiVersion: argoproj.io/v1alpha1
    kind: ApplicationSet
    metadata:
      name: my-svc-preview
      namespace: argocd
    spec:
      generators:
        - pullRequest:
            gitlab:
              gitlabUrl: https://gitlab.example.com
              labels:
                - preview
              project: "42"
              tokenRef:
                key: token
                secretName: gitlab-token
            requeueAfterSeconds: 600
      goTemplate: true
      goTemplateOptions:
        - missingkey=error
      template:
        metadata:
          name: my-svc-preview-{{.number}}-{{.branch_slug}}
        spec:
          destination:
            namespace: my-svc-preview
            server: https://kubernetes.default.svc
          project: my-svc
          source:
            helm:
              parameters:
                - name: image.repository
                  value: registry.example.com/team/my-svc
                - name: image.tag
                  value: '{{.head_sha}}'
              releaseName: my-svc-preview-{{.number}}
            path: k8s/chart
            repoURL: https://gitlab.example.com/team/my-svc.git
            targetRevision: '{{.head_sha}}'
          syncPolicy:
            automated:
              prune: true
              selfHeal: true
            syncOptions:
              - CreateNamespace=true
              - ServerSideApply=true
              - FailOnSharedResource=true
