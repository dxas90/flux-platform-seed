
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
  ],

  // Dependency dashboard
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',

  // Notifications
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],

  // Schedule: midnight to 5 AM (Warsaw time)
  timezone: 'Europe/Warsaw',
  schedule: [
    '* 0-4 * * *',
  ],

  // PR management
  rebaseWhen: 'conflicted',
  pruneStaleBranches: true,
  labels: ['dependencies', 'renovate'],

  // Merge only after passing checks
  automerge: false,
  automergeType: 'pr',
  ignoreTests: false,

  // Delay new releases by 3 days
  minimumReleaseAge: '3 days',

  // FluxCD support (.yaml and .yml)
  flux: {
    managerFilePatterns: [
      '/\\.ya?ml$/',
    ],
  },

  packageRules: [
    {
      description: 'Automerge minor and patch updates, including FluxCD',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Never automerge major upgrades',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
  ],
}
