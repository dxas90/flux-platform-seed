{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
  ],

  // Dependency dashboard
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',

  // Notifications
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],

  // Schedule: midnight to 5 AM (Warsaw time)
  timezone: 'Europe/Warsaw',
  schedule: [
    '* 0-4 * * *',
  ],

  // PR management
  rebaseWhen: 'conflicted',
  pruneStaleBranches: true,
  labels: ['dependencies', 'renovate'],

  // Merge only after passing checks
  automerge: false,
  automergeType: 'pr',
  ignoreTests: false,

  // Delay new releases by 3 days
  minimumReleaseAge: '3 days',

  // FluxCD support (.yaml and .yml) — tracks HelmRelease chart versions and OCIRepository tags.
  flux: {
    managerFilePatterns: [
      '/\\.ya?ml$/',
    ],
  },

  // Custom managers for versions the flux manager cannot see.
  customManagers: [
    {
      customType: 'regex',
      description: 'Flux distribution version in FluxInstance',
      managerFilePatterns: ['/(^|/)flux-instance\\.ya?ml$/'],
      matchStrings: [
        'distribution:\\s+version:\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'fluxcd/flux2',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      description: 'CRD bundles pinned by GitHub release URL',
      managerFilePatterns: ['/(^|/)kustomization\\.ya?ml$/'],
      matchStrings: [
        'https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'flux-operator OCI chart in bootstrap scripts',
      managerFilePatterns: ['/(^|/)scripts/.+\\.sh$/'],
      matchStrings: [
        'oci://(?<depName>ghcr\\.io/controlplaneio-fluxcd/charts/flux-operator)[^\\n]*\\n(?:[^\\n]*\\n){0,6}?\\s*--version\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      description: 'Automerge minor and patch updates, including FluxCD',
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Never automerge major upgrades',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: 'Group Grafana charts',
      matchPackageNames: ['/^ghcr\\.io\\/grafana(-community)?\\//'],
      groupName: 'grafana charts',
    },
    {
      description: 'Group Flux and flux-operator',
      matchPackageNames: ['fluxcd/flux2', '/controlplaneio-fluxcd/'],
      groupName: 'flux',
    },
  ],
}
